generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  password      String
  name          String
  role          UserRole  @default(TELLER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)
  createdCustomers    Customer[]  @relation("CreatedBy")
  approvedAccounts   Account[]   @relation("ApprovedBy")
  requestedWithdrawals WithdrawalAuthorization[] @relation("RequestedBy")
  approvedWithdrawals WithdrawalAuthorization[] @relation("ApprovedWithdrawal")
  reversedWithdrawals WithdrawalAuthorization[] @relation("ReversedWithdrawal")
  approvedLoans      Loan[]      @relation("ApprovedLoan")
  createdExpenses    Expense[]   @relation("CreatedExpense")
  approvedExpenses   Expense[]   @relation("ApprovedExpense")
  settingsUpdates    SystemSettings[] @relation("SettingsUpdatedBy")
}

model Customer {
  id                String    @id @default(uuid())
  customerNumber    String    @unique  // Human-readable customer ID like CUST000000001
  name              String
  isHidden          Boolean   @default(false)
  hiddenAt          DateTime?
  email             String?   @unique
  phone             String?
  address           String?
  kycStatus         KYCStatus @default(PENDING)
  dateJoined        DateTime  @default(now())
  firstName         String?
  surname           String?
  otherName         String?
  gender           String?
  dateOfBirth      DateTime?
  occupation       String?
  workplace        String?
  maritalStatus    String?
  residentialAddress String?
  postalAddress    String?
  contactNumber    String?
  city             String?
  photo            String?
  signature        String?
  identificationType String?
  identificationNumber String?
  beneficiaryName    String?
  beneficiaryContact String?
  beneficiaryRelation String?
  beneficiaryPercentage Int?
  beneficiary2Name    String?
  beneficiary2Contact String?
  beneficiary2Relation String?
  beneficiary2Percentage Int?
  beneficiary3Name    String?
  beneficiary3Contact String?
  beneficiary3Relation String?
  beneficiary3Percentage Int?
  createdBy       User      @relation("CreatedBy", fields: [createdById], references: [id])
  createdById     String
  accounts        Account[]
  loans           Loan[]
  loanGuarantees  LoanGuarantor[] @relation("LoanGuarantor")
  incomeRecords   BankIncome[] @relation("IncomeCustomer")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Account {
  id              String    @id @default(uuid())
  accountNumber   String    @unique
  type            AccountType
  status          AccountStatus @default(ACTIVE)
  authorizationStatus AccountAuthorizationStatus @default(PENDING)
  balance         Decimal   @default(0) // Legacy field - will be calculated from ledger
  currency        String    @default("USD")
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  dateOpened      DateTime  @default(now())
  lastTransactionDate DateTime?
  minimumBalance  Decimal?
  overdraftLimit  Decimal?
  shareBalance    Decimal?  @default(0) // Legacy field - will be calculated from ledger
  sharesAvailableBalance Decimal? @default(0)
  approvedBy      User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedById    String?
  transactions    Transaction[]
  ledgerEntries   LedgerEntry[]
  pendingTransactions PendingTransaction[]
  balanceSnapshot AccountBalanceSnapshot?
  withdrawalAuthorizations WithdrawalAuthorization[] @relation("WithdrawalAccount")
  incomingTransfers WithdrawalAuthorization[] @relation("TransferDestinationAccount")
  loan            Loan?
  guarantorLoans  LoanGuarantor[] @relation("GuarantorAccount")
  restrictions    AccountRestriction[] @relation("RestrictedAccount")
  incomeRecords   BankIncome[] @relation("IncomeAccount")
  expensePayments Expense[] @relation("ExpensePayment")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?    // ID of user who created the account
}

model Transaction {
  id              String    @id @default(uuid())
  type            TransactionType
  amount          Decimal
  status          TransactionStatus @default(COMPLETED)
  description     String?
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id])
  ledgerEntries   LedgerEntry[]
  reference       String?   @unique
  date           DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WithdrawalAuthorization {
  id              String    @id @default(uuid())
  accountId       String
  account         Account   @relation("WithdrawalAccount", fields: [accountId], references: [id])
  amount          Decimal
  type            WithdrawalType
  description     String?
  reference       String?
  toAccountId     String?   // For transfers - actual destination account to credit on approval
  toAccount       Account?  @relation("TransferDestinationAccount", fields: [toAccountId], references: [id])
  toAccountNumber String?   // For transfers - display only
  toCustomerName  String?   // For transfers - display only
  status          WithdrawalAuthorizationStatus @default(PENDING)
  requestedAt     DateTime  @default(now())
  requestedBy     User      @relation("RequestedBy", fields: [requestedById], references: [id])
  requestedById   String
  approvedBy      User?     @relation("ApprovedWithdrawal", fields: [approvedById], references: [id])
  approvedById    String?
  approvedAt      DateTime?
  rejectedReason  String?
  isReversed      Boolean   @default(false)
  reversedBy      User?     @relation("ReversedWithdrawal", fields: [reversedById], references: [id])
  reversedById    String?
  reversedAt      DateTime?
  reversalReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Loan {
  id                String    @id @default(uuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  accountId         String    @unique
  account           Account   @relation(fields: [accountId], references: [id])
  amount            Decimal
  interestRate      Decimal
  term              Int       // in months
  status            LoanStatus @default(ACTIVE)
  authorizationStatus LoanAuthorizationStatus @default(PENDING)
  repaymentFrequency RepaymentFrequency @default(MONTHLY)
  startDate         DateTime  @default(now())
  endDate           DateTime
  totalPayable      Decimal
  amountPaid        Decimal   @default(0)
  outstandingBalance Decimal
  nextPaymentDate   DateTime?
  monthlyPayment    Decimal
  rejectionReason   String?   // Reason for rejection if authorization status is REJECTED
  
  // Enhanced loan fields
  customerContribution Decimal   // Amount from customer's own account
  guaranteeRequired    Decimal   // Amount that needs guarantor backing
  totalPaid           Decimal   @default(0)
  totalInterestPaid   Decimal   @default(0)
  guarantorReimbursed Decimal   @default(0)
  principalRemaining  Decimal   
  isCompleted         Boolean   @default(false)
  lastPaymentDate     DateTime?
  lastPaymentAmount   Decimal   @default(0)
  
  // Guarantor relationships with amounts
  guarantors          LoanGuarantor[]
  restrictions        AccountRestriction[] @relation("LoanRestrictions")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?   // ID of user who created the loan
  approvedBy         User?     @relation("ApprovedLoan", fields: [approvedById], references: [id])
  approvedById      String?
  approvedAt        DateTime?
}

model SystemSettings {
  id                      Int      @id @default(1)
  withdrawalFee           Decimal  @default(5.00)
  defaultLoanInterestRate Decimal  @default(5.00)
  updatedAt               DateTime @updatedAt
  updatedById             String?
  updatedBy               User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id])
}

model BankIncome {
  id              String    @id @default(uuid())
  type            IncomeType
  amount          Decimal
  description     String?
  sourceId        String?   // Could be transaction ID or loan ID
  sourceType      String?   // "transaction" or "loan"
  accountId       String?   // Account involved in generating income
  account         Account?  @relation("IncomeAccount", fields: [accountId], references: [id])
  customerId      String?   // Customer involved in generating income
  customer        Customer? @relation("IncomeCustomer", fields: [customerId], references: [id])
  date            DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Expense {
  id                String        @id @default(uuid())
  date              DateTime
  category          String
  description       String
  amount            Decimal
  vendor            String
  department        String
  status            ExpenseStatus @default(PENDING)
  paymentMethod     String?
  referenceNumber   String?
  notes             String?
  approvedById      String?
  approvedByUser    User?         @relation("ApprovedExpense", fields: [approvedById], references: [id])
  approvedDate      DateTime?
  paidDate          DateTime?
  paidFromAccountId String?       // Treasury account debited when this expense was marked PAID
  paidFromAccount   Account?      @relation("ExpensePayment", fields: [paidFromAccountId], references: [id])
  createdById       String
  createdByUser     User          @relation("CreatedExpense", fields: [createdById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  TELLER
}

enum KYCStatus {
  VERIFIED
  PENDING
  REJECTED
}

enum AccountType {
  SAVINGS
  CURRENT
  FIXED
  LOAN
  TREASURY
}

enum AccountStatus {
  ACTIVE
  DORMANT
  CLOSED
  FROZEN
}

enum AccountAuthorizationStatus {
  APPROVED
  PENDING
  REJECTED
}

enum TransactionType {
  DEPOSIT
  DEPOSIT_SHARES
  WITHDRAWAL
  WITHDRAWAL_SHARES
  TRANSFER
  LOAN_REPAYMENT
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

enum WithdrawalType {
  WITHDRAWAL
  WITHDRAWAL_SHARES
  TRANSFER
}

enum WithdrawalAuthorizationStatus {
  APPROVED
  PENDING
  REJECTED
}

enum LoanStatus {
  ACTIVE
  PAID
  DEFAULTED
  CLOSED
}

enum LoanAuthorizationStatus {
  APPROVED
  PENDING
  REJECTED
}

enum RepaymentFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum IncomeType {
  WITHDRAWAL_CHARGE
  LOAN_INTEREST
  TRANSFER_FEE
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// Ledger-based double-entry system models
model LedgerEntry {
  id            String    @id @default(uuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type          LedgerEntryType
  amount        Decimal
  currency      String    @default("GHS")
  reference     String
  description   String?
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  metadata      Json?
  createdAt     DateTime  @default(now())
  createdBy     String?

  @@index([accountId, createdAt])
  @@index([reference])
  @@index([transactionId])
  @@index([type])
}

model PendingTransaction {
  id          String    @id @default(uuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type        PendingTransactionType
  amount      Decimal
  currency    String    @default("GHS")
  reference   String
  description String?
  expiresAt   DateTime?
  metadata    Json?
  status      PendingTransactionStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  settledAt   DateTime?
  createdBy   String?

  @@index([accountId, status])
  @@index([reference])
  @@index([expiresAt])
}

model AccountBalanceSnapshot {
  id                  String    @id @default(uuid())
  accountId           String    @unique
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balance             Decimal   @default(0)      // Legacy balance for migration
  shareBalance        Decimal   @default(0)      // Legacy share balance for migration
  ledgerBalance       Decimal   @default(0)      // Calculated from ledger entries
  pendingBalance      Decimal   @default(0)      // Sum of pending transactions
  availableBalance    Decimal   @default(0)      // ledgerBalance - pendingBalance
  lastLedgerEntryId   String?
  snapshotAt          DateTime  @default(now())

  @@index([snapshotAt])
}

// Enums for the ledger system
enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum PendingTransactionType {
  HOLD
  RESERVE
}

enum PendingTransactionStatus {
  ACTIVE
  SETTLED
  RELEASED
  EXPIRED
}

// New models for enhanced loan guarantee system
model LoanGuarantor {
  id                String    @id @default(uuid())
  loanId            String
  loan              Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  guarantorId       String
  guarantor         Customer  @relation("LoanGuarantor", fields: [guarantorId], references: [id])
  guarantorAccountId String
  guarantorAccount  Account   @relation("GuarantorAccount", fields: [guarantorAccountId], references: [id])
  guaranteedAmount  Decimal
  amountReimbursed  Decimal   @default(0) // Paid back to this guarantor so far from repayments
  status           GuarantorStatus @default(ACTIVE)
  restrictions     AccountRestriction[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([loanId, guarantorId])
  @@index([guarantorId])
  @@index([loanId])
}

model AccountRestriction {
  id                String         @id @default(uuid())
  accountId         String
  account           Account        @relation("RestrictedAccount", fields: [accountId], references: [id], onDelete: Cascade)
  restrictionType   RestrictionType
  restrictedAmount  Decimal        // Amount that cannot be withdrawn
  reason           String
  loanGuarantorId  String?
  loanGuarantor    LoanGuarantor? @relation(fields: [loanGuarantorId], references: [id], onDelete: Cascade)
  loanId           String?        // Set for LOAN_OWN_BACKING holds (borrower's own 50% backing)
  loan             Loan?          @relation("LoanRestrictions", fields: [loanId], references: [id], onDelete: Cascade)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  releasedAt       DateTime?
  createdBy        String?

  @@index([accountId, isActive])
  @@index([loanGuarantorId])
  @@index([loanId])
}

enum GuarantorStatus {
  ACTIVE
  RELEASED
  DEFAULTED
  FUNDS_RETURNED
}

enum RestrictionType {
  LOAN_GUARANTEE
  LOAN_OWN_BACKING
  COURT_ORDER
  COMPLIANCE_HOLD
}

// Immutable append-only audit event stream for compliance and forensic review
model AuditEvent {
  id          String   @id
  eventType   String
  entityType  String
  entityId    String?
  action      String
  outcome     String
  actorUserId String?
  actorRole   String?
  requestId   String?
  method      String?
  route       String?
  reference   String?
  ipAddress   String?
  userAgent   String?  @db.VarChar(512)
  beforeData  Json?
  afterData   Json?
  metadata    Json?
  prevHash    String?  @db.Char(64)
  eventHash   String   @unique @db.Char(64)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
}
